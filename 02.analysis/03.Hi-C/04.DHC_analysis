     "metadata": {
      "image/png": {
       "height": 900,
       "width": 900
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "phic <- read.table(\"../04.matrices/comp/impute/disease/dchic/DifferentialResult/fdr_result/differential.intra_sample_combined.pcQnm.bedGraph\", sep='\\t', header = T) %>%\n",
    "mutate(range = paste0(chr, \":\", start, '-', end)) %>%\n",
    "tibble::column_to_rownames(\"range\")\n",
    "\n",
    "phic <- phic[,grep(\"100Kb\", colnames(phic))]\n",
    "colnames(phic) <- gsub(\"_100Kb\", \"\", colnames(phic))\n",
    "phic[phic > 0] <- \"A\"\n",
    "phic[phic < 0] <- \"B\"\n",
    "\n",
    "for (f in unique(meta$nn2.celltype)){\n",
    "    data <- phic[, grep(f, colnames(phic))] %>% count(across(everything()))\n",
    "    plist[[f]] <- data %>%\n",
    "    mutate(id = 1:nrow(.)) %>%\n",
    "    tidyr::pivot_longer(cols = starts_with(f), names_to = \"stage\", values_to = \"state\") %>%\n",
    "    ggplot(aes(x = stage, stratum = state, alluvium = id, y = n, fill = state)) +\n",
    "    geom_flow() + ylab(\"Frequency\") + \n",
    "    geom_stratum(color = \"white\") +\n",
    "    theme_Publication() + ggtitle(paste0(\"A2B \", data[data[,1] == \"A\" & data[,2] == \"B\",]$n, \n",
    "                                         \", B2A \", data[data[,1] == \"B\" & data[,2] == \"A\",]$n)) + \n",
    "    NoLegend() + \n",
    "    scale_fill_manual(values = colorRampPalette((brewer.pal(n = 8, name = \"RdBu\")))(8)[c(1,7)])\n",
    "}\n",
    "\n",
    "fig1 <- cowplot::plot_grid(plotlist = plist, nrow = 3)\n",
    "\n",
    "fig1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 104,
   "id": "1eb3babb",
   "metadata": {},
   "outputs": [],
   "source": [
    "### what are the compartments got shifted?\n",
    "ab <- ba <- list()\n",
    "for (f in unique(meta$nn2.celltype)){\n",
    "    data <- phic[, sort(grep(f, colnames(phic), value = T))] %>% \n",
    "    setNames(c(\"c\", \"d\")) %>%\n",
    "    mutate(type = paste0(c, \"_\", d), celltype = f) %>%\n",
    "    tibble::rownames_to_column(\"bin\")\n",
    "    ab[[f]] <- data %>% filter(type == \"A_B\")\n",
    "    ba[[f]] <- data %>% filter(type == \"B_A\")\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 230,
   "id": "10a88a90",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Get delta comp larger than 2?\n",
    "afb <- bfa <- list()\n",
    "for (f in unique(meta$nn2.celltype)){\n",
    "    data <- chic[, sort(grep(f, colnames(chic), value = T))] %>% \n",
    "    setNames(c(\"c\", \"d\")) %>%\n",
    "    filter(abs(c - d) >= 2) %>%\n",
    "    mutate(celltype = f) %>%\n",
    "    tibble::rownames_to_column(\"bin\")\n",
    "    afb[[f]] <- data %>% filter(c > 0, d < 0)\n",
    "    bfa[[f]] <- data %>% filter(c < 0, d > 0)\n",
    "}"
   ]
  },
