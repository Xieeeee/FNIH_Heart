   "source": [
    "rpkm <- read.table(\"../../81.FNIH_DPT_IGM_240827/05.R/FNIH_Heart_pool.DPT.rpkm.txt\")\n",
    "\n",
    "options(repr.plot.width = 6, repr.plot.height = 5)\n",
    "rmat <- rpkm[unique(gene[subjectHits(findOverlaps(qrange, grange)),]$V6), corder] \n",
    "max_indices <- max.col(rmat)\n",
    "permutation_vector <- order(max_indices)\n",
    "smat <- rmat[permutation_vector, ]\n",
    "t1 <- smat %>% t %>%\n",
    "pheatmap(cluster_rows = F, cluster_cols = F, border_color = NA, \n",
    "         scale = \"column\", angle_col = 45, color = colorRampPalette(c(\"white\", \"#59b4a2\"))(25))"
   ]
  },
