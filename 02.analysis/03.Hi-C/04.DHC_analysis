   "source": [
    "### list of overlap genes\n",
    "tmp <- geneder %>% filter(celltype == \"vCM\")\n",
    "t1 <- tmp %>%\n",
    "ggplot(aes(x = log2FoldChange, y = -log10(padj))) +\n",
    "geom_point(alpha = 0.5, color = \"grey\", size = 1) + \n",
    "geom_point(data = tmp[tmp$gene %in% a2bg[[\"vCM\"]],], \n",
    "           aes(x = log2FoldChange, y = -log10(padj)), \n",
    "           alpha = 0.8, color = '#4393C3', size = 1) + \n",
    "geom_point(data = tmp[tmp$gene %in% b2ag[[\"vCM\"]],], \n",
    "           aes(x = log2FoldChange, y = -log10(padj)), \n",
    "           alpha = 0.8, color = \"#B2182B\", size = 1) +\n",
    "xlim(-5, 5) + \n",
    "geom_hline(yintercept = -log10(0.05), linetype = \"dashed\", color = \"black\") +\n",
    "theme_Publication()\n",
    "\n",
    "t1"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ff87bc27",
   "metadata": {},
   "source": [
    "## Compare overall changes in compartment interactions (AA/BB)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 283,
   "id": "129b5b74",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Using celltype, condition as id variables\n",
      "\n",
      "Using celltype, condition as id variables\n",
      "\n"
     ]
    }
   ],
   "source": [
    "compfuse <- read.csv(\"../../87.FNIH_DHC_IGM_240925/04.matrices/comp/FNIH_heart_dhc_celltype_HF_compstr.impute.csv\", row.names = 1)\n",
    "compfuse[,c(\"celltype\", \"condition\")] <- stringr::str_split_fixed(rownames(compfuse), pattern = \"_\", n = 2)\n",
    "\n",
    "options(repr.plot.width = 8, repr.plot.height = 4)\n",
    "t1 <- compfuse %>% mutate(B_int = BB/BA, A_int = AA/AB, cross_int = (BA+AB)/(BB+AA)) %>%\n",
    "select(c(celltype, condition, B_int, A_int, cross_int)) %>%\n",
    "reshape2::melt(value.vars = c(\"B_int\", \"A_int\", \"cross_int\")) %>%\n",
    "mutate(celltype = factor(celltype, levels = corder)) %>%\n",
    "arrange(celltype) %>%\n",
    "filter(variable != \"cross_int\") %>%\n",
    "ggplot(aes(x = condition, y = value)) +\n",
    "geom_boxplot(fill = \"grey\", alpha = 0.3, coef = 2, outlier.shape = NA) +\n",
    "geom_point(aes(color = celltype, group = celltype)) + \n",
    "geom_line(aes(color = celltype, group = celltype)) +\n",
    "facet_grid(. ~ variable) + \n",
    "theme_classic() + ylab(\"Intra compartment interactions\") +\n",
    "scale_color_manual(values = celltype_colors)\n",
    "\n",
    "options(repr.plot.width = 4, repr.plot.height = 4)\n",
    "t2 <- compfuse %>% mutate(B_int = BB/BA, A_int = AA/AB, cross_int = (BA+AB)/(BB+AA)) %>%\n",
    "select(c(celltype, condition, B_int, A_int, cross_int)) %>%\n",
    "reshape2::melt(value.vars = c(\"B_int\", \"A_int\", \"cross_int\")) %>%\n",
    "mutate(celltype = factor(celltype, levels = corder)) %>%\n",
    "arrange(celltype) %>%\n",
    "filter(variable == \"cross_int\") %>%\n",
    "ggplot(aes(x = condition, y = value)) +\n",
    "geom_boxplot(fill = \"grey\", alpha = 0.3, coef = 2, outlier.shape = NA) +\n",
    "geom_point(aes(color = celltype, group = celltype)) + \n",
    "geom_line(aes(color = celltype, group = celltype)) +\n",
    "theme_classic() + ylab(\"Inter compartment interactions\") +\n",
    "scale_color_manual(values = celltype_colors)"
   ]
  },
