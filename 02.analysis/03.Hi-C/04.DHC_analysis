   "source": [
    "fcomp <- fcomp2 <- fcomp1 <- list()\n",
    "b2ag <- a2bg <- list()\n",
    "for (f in korder){\n",
    "    qgene1 <- genede %>% filter(celltype == f, log2FoldChange > 0) %>% select(gene) %>% unlist\n",
    "    qgene2 <- genede %>% filter(celltype == f, log2FoldChange < 0) %>% select(gene) %>% unlist\n",
    "    bg1 <- geneder %>% filter(celltype == f, padj >= 0.05) %>% slice_sample(n = length(qgene1)) %>% select(gene) %>% unlist\n",
    "    bg2 <- geneder %>% filter(celltype == f, padj >= 0.05) %>% slice_sample(n = length(qgene2)) %>% select(gene) %>% unlist\n",
    "    \n",
    "    print(paste0(\"celltype \", f, \"; up genes: \", length(qgene1)))\n",
    "    print(paste0(\"celltype \", f, \"; down genes: \", length(qgene2)))\n",
    "    \n",
    "    qbin1 <- result %>% filter(gene %in% qgene1) %>% select(bin) %>% unlist\n",
    "    qbin2 <- result %>% filter(gene %in% qgene2) %>% select(bin) %>% unlist\n",
    "    bgbin1 <- result %>% filter(gene %in% bg1) %>% select(bin) %>% unlist\n",
    "    bgbin2 <- result %>% filter(gene %in% bg2) %>% select(bin) %>% unlist\n",
    "    tbin1 <- gsub(\"_\", \"-\", ab[[f]]$bin)\n",
    "    tbin2 <- gsub(\"_\", \"-\", ba[[f]]$bin)\n",
    "\n",
    "    l01 <- result[result$bin %in% intersect(tbin2, qbin1),] %>% \n",
    "    select(gene) %>% unlist %>% unique %>% length\n",
    "    l02 <- result[result$bin %in% intersect(tbin1, qbin1),] %>% \n",
    "    select(gene) %>% unlist %>% unique %>% length\n",
    "    \n",
    "    l11 <- result[result$bin %in% intersect(tbin2, bgbin1),] %>% \n",
    "    select(gene) %>% unlist %>% unique %>% length\n",
    "    l12 <- result[result$bin %in% intersect(tbin1, bgbin1),] %>% \n",
    "    select(gene) %>% unlist %>% unique %>% length\n",
    "    \n",
    "    b2ag[[f]] <- result[result$bin %in% intersect(tbin2, qbin1),] %>% \n",
    "    select(gene) %>% unlist %>% unique\n",
    "    \n",
    "    print(paste0(\"celltype \", f, \"; number of B2A ovlp up-gene: \", l01))\n",
    "    print(paste0(\"celltype \", f, \"; number of A2B ovlp up-gene: \", l02))\n",
    "    \n",
    "    l1 <- result[result$bin %in% intersect(tbin1, qbin2),] %>% \n",
    "    select(gene) %>% unlist %>% unique %>% length\n",
    "    l2 <- result[result$bin %in% intersect(tbin2, qbin2),] %>% \n",
    "    select(gene) %>% unlist %>% unique %>% length\n",
    "    \n",
    "    l11 <- result[result$bin %in% intersect(tbin1, bgbin2),] %>% \n",
    "    select(gene) %>% unlist %>% unique %>% length\n",
    "    l12 <- result[result$bin %in% intersect(tbin2, bgbin2),] %>% \n",
    "    select(gene) %>% unlist %>% unique %>% length\n",
    "    \n",
    "    a2bg[[f]] <- result[result$bin %in% intersect(tbin1, qbin2),] %>% \n",
    "    select(gene) %>% unlist %>% unique\n",
    "    \n",
    "    print(paste0(\"celltype \", f, \"; number of A2B ovlp down-gene: \", l1))\n",
    "    print(paste0(\"celltype \", f, \"; number of B2A ovlp down-gene: \", l2))\n",
    "\n",
    "    \n",
    "}"
   ]
  },
