   ],
   "source": [
    "qins <- ins[,corder]\n",
    "qins[,c(\"V1\", \"V2\", \"V3\")] <- stringr::str_split_fixed(rownames(qins), pattern = \"-\", n = 3)\n",
    "qtp <- stringr::str_split_fixed(diffbound[qbin$bin,]$bin, pattern = \"-\", n = 3) %>% as.data.frame\n",
    "\n",
    "### subset a 1Mb window for insulation score plotting\n",
    "plist <- list()\n",
    "for (i in 1:nrow(qtp)){\n",
    "    chrom <- qtp$V1[i]\n",
    "    start <- as.integer(qtp$V2[i]) - 500000\n",
    "    end <- as.integer(qtp$V3[i]) + 500000\n",
    "    vbin <- qins %>% filter(V1 == chrom & as.integer(V2) >= start & as.integer(V3) <= end) %>% rownames %>% \n",
    "    as.data.frame %>% setNames(\"bin\") %>% mutate(rank = seq_along(bin))\n",
    "    tmp <- qins %>% tibble::rownames_to_column(\"bin\") %>%\n",
    "    filter(bin %in% vbin$bin) \n",
    "    tmp$rank <- vbin[match(tmp$bin, vbin$bin),]$rank\n",
    "    \n",
    "    plist[[i]] <- tmp[,setdiff(colnames(tmp), c(\"V1\", \"V2\", \"V3\", \"bin\"))] %>%\n",
    "    reshape2::melt(id.vars = c(\"rank\")) %>%\n",
    "    mutate(value = as.numeric(value)) %>% \n",
    "    mutate(variable = factor(variable, levels = corder)) %>% arrange(variable) %>%\n",
    "    ggplot(aes(x = rank, y = log2(value), color = variable)) + \n",
    "    geom_line() + \n",
    "    xlab(paste0(chrom, \":\", start, \"-\", end)) + ylab(\"\") + \n",
    "    annotate(\"rect\", xmin=19, xmax=21, ymin=-Inf, ymax=Inf, alpha=0.5, fill=\"grey\") + \n",
    "    theme_classic() + theme(axis.line.x = element_blank(), axis.text.x = element_blank()) + \n",
    "    scale_color_manual(values = celltype_colors) + \n",
    "    NoLegend() \n",
    "}\n",
    "\n",
    "fig1 <- cowplot::plot_grid(plotlist = plist, ncol = 4)\n",
    "\n",
    "options(repr.plot.width = 15, repr.plot.height = 15)\n",
    "fig1\n",
    "ggsave(fig1, filename = \"FNIH_Heart_DHC_ins_by_celltype.example.pdf\", dpi = 300, height = 10, width = 15)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2ade9094-8c91-4108-897a-ad6111a5b398",
