   ],
   "source": [
    "fcomp <- list()\n",
    "for (f in corder){\n",
    "    qgene <- qry_gene %>% filter(cluster == f) %>% select(gene) %>% unlist\n",
    "    qbin <- result %>% filter(gene %in% qgene) %>% select(bin) %>% unlist\n",
    "    tbin <- rownames(comp[comp[,f] > 0.1,])\n",
    "    tmp <- comp[intersect(tbin, qbin), ]\n",
    "    sbin <- tmp[apply(tmp, 1, function(row) sum(row < 0) >= 6), ] %>% rownames\n",
    "    print(paste0(\"celltype \", f, \"; number of compartment A ovlp markers: \", length(sbin)))\n",
    "    fcomp[[f]] <- tmp[sbin,] %>% mutate(celltype = f) %>% mutate(bin = rownames(.))\n",
    "    \n",
    "}\n",
    "\n",
    "options(repr.plot.width = 6, repr.plot.height = 5)\n",
    "\n",
    "rmat <- do.call(rbind, fcomp) %>% select(corder)\n",
    "rmat <- rmat[, corder]\n",
    "max_indices <- max.col(rmat)\n",
    "permutation_vector <- order(max_indices)\n",
    "smat <- rmat[permutation_vector, ]\n",
    "smat %>%\n",
    "pheatmap(cluster_rows = F, cluster_cols = F, border_color = NA,\n",
    "         scale = \"none\", show_rownames = F, angle_col = 45)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 196,
   "id": "498e4ef2",
   "metadata": {},
   "outputs": [],
   "source": [
    "set.seed(921)\n",
    "qb <- list()\n",
    "mtx <- do.call(rbind, fcomp)[,corder] %>% apply(MARGIN = 1, function(x) (x-mean(x))/sd(x)) %>% t %>% as.data.frame\n",
    "mtx[,c(\"celltype\", \"bin\")] <- do.call(rbind, fcomp)[,c(\"celltype\", \"bin\")]\n",
    "                                                for (f in corder){\n",
    "    qb[[f]] <- mtx %>% filter(celltype == f) %>% \n",
    "    arrange(desc(f)) %>% head(2)\n",
    "}\n",
    "qb <- do.call(rbind, qb) %>%\n",
    "mutate(celltype = factor(celltype, levels = corder)) %>% arrange(celltype)\n",
    "                                                \n",
    "qtp <- unique(qb$bin) %>% stringr::str_split_fixed(pattern = \"-\", n = 3) %>% \n",
    "as.data.frame %>% mutate(V2 = as.integer(V2)-1)"
   ]
  },
