   "source": [
    "### show boundary probability for celltype specific boundary\n",
    "bound_prob = read.csv(\"../impute/25K/cool/DONOR/FNIH_Heart_DHC_Donor_celltype_boundprob.csv\", row.names = 1)\n",
    "diffbound = read.csv(\"../impute/25K/cool/DONOR/FNIH_Heart_DHC_DONOR_celltype_diffbound.csv\", row.names = 1)\n",
    "btp <- diffbound %>% filter(bklfilter == \"True\", diff_sc == 1) %>% rownames\n",
    "length(btp)\n",
    "\n",
    "options(repr.plot.width = 4, repr.plot.height = 8)\n",
    "rmat <- bound_prob[btp,]\n",
    "max_indices <- max.col(rmat)\n",
    "permutation_vector <- order(max_indices)\n",
    "smat <- rmat[permutation_vector, ]\n",
    "\n",
    "set.seed(921)\n",
    "t1 <- smat %>%\n",
    "pheatmap(scale = \"none\", show_rownames = F, angle_col = 45, breaks = seq(0, 1, 0.04),\n",
    "         color = colorRampPalette(rev(brewer.pal(n = 8, name = \"RdBu\")))(25))\n",
    "ggsave(t1, filename = \"plot/FIG_celltype_specific_boundary_prob.pdf\", dpi = 300, height = 8, width = 4)"
   ]
  },
  {
   "cell_type": "code",
