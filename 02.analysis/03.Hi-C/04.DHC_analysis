   "source": [
    "gene <- read.table(\"/projects/ps-renlab2/y2xie/ps-renlab/y2xie/projects/genome_ref/Paired-Tag/hg38/hg38.gcode.10X.bed\")\n",
    "grange <- GenomicRanges::GRanges(gene$V1, IRanges::IRanges(gene$V2, gene$V3))\n",
    "qrange <- diffbound[qbin$bin, ]\n",
    "qrange <- GenomicRanges::GRanges(qrange[,1], IRanges::IRanges(as.integer(qrange[,2]), as.integer(qrange[,3])))\n",
    "\n",
    "gene[subjectHits(findOverlaps(qrange, grange)),]$V6 %>%\n",
    "unique"
   ]
  },
