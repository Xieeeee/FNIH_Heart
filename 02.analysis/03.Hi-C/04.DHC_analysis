   "source": [
    "korder <- c(\"Myeloid\", \"Endothelial\", \"Fibroblast\", \"aCM\", \"vCM\")\n",
    "domain_size <- read.csv(\"FNIH_Heart_DHC_Donor_celltype_disease_boundary_filtered_summary.csv\", row.names = 1)\n",
    "\n",
    "t1 <- domain_size %>%\n",
    "filter(celltype %in% korder) %>%\n",
    "mutate(celltype = factor(celltype, level = korder)) %>%\n",
    "ggplot(aes(x = celltype, y = domain_count, fill = celltype)) + \n",
    "geom_boxplot(width = 0.5, color = \"black\", alpha = 0.8, coef = 2, outlier.shape = NA) + \n",
    "theme_Publication() + \n",
    "scale_fill_manual(values = celltype_colors)\n",
    "\n",
    "t2 <- domain_size %>%\n",
    "filter(celltype %in% korder) %>%\n",
    "mutate(celltype = factor(celltype, level = korder)) %>%\n",
    "ggplot(aes(x = celltype, y = domain_count, fill = condition)) + \n",
    "geom_boxplot(width = 0.5, color = \"black\", alpha = 0.8, coef = 2, outlier.shape = NA, \n",
    "             position=position_dodge(0.7)) + \n",
    "theme_Publication() + \n",
    "scale_fill_manual(values = colsn)\n",
    "\n",
    "options(repr.plot.width = 10, repr.plot.height = 5)\n",
    "fig1 <- cowplot::plot_grid(t1, t2, ncol = 2)\n",
    "\n",
    "fig1\n",
    "# ggsave(fig1, filename = \"plot/FIG_celltype_CONTROL_vs_HF_domain_count.pdf\", \n",
    "#        dpi = 300, height = 4, width = 10)"
   ]
  },
