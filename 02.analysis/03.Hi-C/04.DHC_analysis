   "source": [
    "### Is this related to donor ages?\n",
    "t1 <- meta[,c(\"DONOR\", \"Age\", \"condition\")] %>% distinct %>%\n",
    "ggplot(aes(x = condition, y = Age)) + \n",
    "geom_boxplot() + \n",
    "geom_jitter(aes(color = condition)) + \n",
    "theme_classic()\n",
    "\n",
    "t1\n",
    "\n",
    "meta[,c(\"DONOR\", \"Gender\", \"condition\")] %>% distinct %>%\n",
    "select(c(Gender, condition)) %>%\n",
    "table\n",
    "### Fuck\n",
    "\n",
    "wilcox.test(t1$data[t1$data$condition == \"HF\",]$Age,\n",
    "            t1$data[t1$data$condition == \"CONTROL\",]$Age, exact = FALSE)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 274,
   "id": "7cda2999",
   "metadata": {
    "scrolled": true
   },
   "outputs": [
    {
     "data": {
      "text/plain": [
       "\n",
       "\tWilcoxon rank sum test with continuity correction\n",
       "\n",
       "data:  t1$data[t1$data$condition == \"HF\", ]$Age and t1$data[t1$data$condition == \"CONTROL\", ]$Age\n",
       "W = 44.5, p-value = 0.4394\n",
       "alternative hypothesis: true location shift is not equal to 0\n"
      ]
     },
