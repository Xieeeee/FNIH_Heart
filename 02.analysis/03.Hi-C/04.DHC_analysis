   "source": [
    "options(repr.plot.width = 8, repr.plot.height = 5)\n",
    "t1 <- tmeta %>% # mutate(rnatype = factor(rnatype, levels = all_order)) %>%\n",
    "ggplot(aes(x = predicted.id, y = predicted.score, fill = predicted.id)) + \n",
    "geom_boxplot(width = 0.25, color = \"black\", alpha = 0.8, coef = 2, outlier.shape = NA) + \n",
    "xlab(\"\") + ylab(\"Cell types prediction score\") + \n",
    "theme_Publication() + theme(legend.position = \"NA\") + \n",
    "theme(axis.text.x = element_text(angle = 45, hjust = 1, size = 12))\n",
    "\n",
    "t1"
   ]
  },
