   "source": [
    "### How many non_zero boundary by celltype?\n",
    "b1 <- boundl[corder] %>% unlist %>% unique\n",
    "\n",
    "### How many non_zero boundary by condition?\n",
    "b2 <- boundl[c(paste0(corder, \"_HF\"))] %>% unlist %>% unique\n",
    "b3 <- boundl[c(paste0(corder, \"_CONTROL\"))] %>% unlist %>% unique\n",
    "\n",
    "b1 %>% length\n",
    "intersect(b1, bklfilter) %>% length\n",
    "intersect(b2, bklfilter) %>% length\n",
    "intersect(b3, bklfilter) %>% length\n",
    "intersect(intersect(b1, b2), bklfilter) %>% length ### 71%\n",
    "intersect(intersect(b1, b3), bklfilter) %>% length ### 61%\n",
    "intersect(intersect(b3, b2), bklfilter) %>% length"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 976,
   "id": "e4379cf4",
   "metadata": {},
   "outputs": [],
   "source": [
    "### remove donor above a certain age\n",
    "ins <- read.csv(\"../impute/25K/domain/young/FNIH_Heart_young.insulation.csv\", row.names = 1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 977,
   "id": "4dc00630",
   "metadata": {},
   "outputs": [],
   "source": [
    "### bulk boundary plot enrichment (window size 20bins):\n",
    "benrich <- list()\n",
    "for (ct in corder){\n",
    "    insrange <- list()\n",
    "#     qbound <- setdiff(boundl[[paste0(ct, \"_HF\")]], boundl[[paste0(ct, \"_CONTROL\")]])\n",
    "    qbound <- Reduce(intersect, boundl[grep(ct, names(boundl))]) ### calculate across boundaries in each cell type\n",
    "    for (f in paste0(\"chr\", 1:22)){\n",
    "        qbbin <- bbin %>% filter(chrom == f) %>% tibble::rowid_to_column(\"id\")\n",
    "        qins <- ins[qbbin$range, grep(ct, colnames(ins))]\n",
    "        sstart <- qbbin %>% filter(range %in% intersect(qbound, bklfilter)) %>% \n",
    "        dplyr::select(range) %>% unlist# %>% as.integer\n",
    "        sstart <- which(rownames(qins) %in% sstart)\n",
    "        tlist <- lapply(sstart, function(x) qins[(x-10):(x+10),] %>% as.matrix)\n",
    "        insrange[[f]] <- (Reduce(\"+\", tlist) / length(tlist))\n",
    "    }\n",
    "    benrich[[ct]] <- (Reduce(\"+\", insrange) / length(insrange)) %>%\n",
    "    as.data.frame %>% tibble::rowid_to_column(\"id\") %>%\n",
    "    reshape2::melt(id.vars = \"id\") %>% mutate(bound = ct) \n",
    "}"
   ]
  },
