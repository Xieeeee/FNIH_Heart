   "source": [
    "options(repr.plot.width = 6.5, repr.plot.height = 6)\n",
    "rmat <- comp[idx, corder]\n",
    "t1 <- cor(rmat) %>%\n",
    "pheatmap(border_color = \"white\", angle_col = 45, breaks = seq(0.5, 1, 0.05),\n",
    "         color = colorRampPalette(rev(brewer.pal(n = 8, name = \"RdYlBu\")))(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 186,
   "id": "0b920746",
   "metadata": {},
   "outputs": [],
   "source": [
    "binall$range <- paste0(binall$chr, \"-\", binall$start, \"-\", binall$end)\n",
    "ctdiff <- binall$range[idx]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 486,
   "id": "76ad057c",
   "metadata": {},
   "outputs": [],
   "source": [
    "### Reconstruct complete compartment for plot for plots\n",
    "### some chrom ends are extended so number will not exactly match\n",
    "binall <- numpy$load(\"../04.matrices/FNIH_heart_dhc_binfilter.npy\", allow_pickle = T)\n",
    "\n",
    "file_path <- \"../04.matrices/comp/FNIH_heart_dhc_celltype_comp.impute.hdf\"\n",
    "df <- pandas$read_hdf(file_path)\n",
    "dfr <- as.data.frame(df)\n",
    "\n",
    "allcomp <- list()\n",
    "chromall <- gsub(\"^([^-]+)-.*\", \"\\\\1\", rownames(dfr)) %>% unique\n",
    "for (i in seq_along(chromall)){\n",
    "    chrom <- chromall[i]\n",
    "    tmp <- binall[[i]] %>% length\n",
    "    tcomp <- matrix(data = 0, nrow = tmp, ncol = ncol(comp)) %>% as.data.frame\n",
    "    colnames(tcomp) <- colnames(dfr)\n",
    "    rownames(tcomp) <- paste0(chrom, \"-\", as.integer(100000*(0:(tmp-1))), \"-\", as.integer(100000*(1:tmp)))\n",
    "    ttcomp <- dfr[grep(paste0(chrom, \"-\"), rownames(dfr), value = T),]\n",
    "    tcomp[grep(paste0(chrom, \"-\"), rownames(dfr), value = T),] <- ttcomp\n",
    "    allcomp[[i]] <- tcomp\n",
    "}\n",
    "\n",
    "allcomp <- do.call(rbind, allcomp)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 399,
   "id": "542d8b7d",
   "metadata": {},
   "outputs": [],
   "source": [
    "### for plotting: smooth filtered bins\n",
    "smooth_zeros <- function(df) {\n",
    "  for (i in 1:nrow(df)) {\n",
    "    if (all(df[i, ] == 0)) {\n",
    "      prev_rows <- max(1, i - 4):(i - 1)\n",
    "      next_rows <- (i + 1):min(nrow(df), i + 4)\n",
    "      surrounding_rows <- df[c(prev_rows, next_rows), ]\n",
    "      df[i, ] <- colMeans(surrounding_rows, na.rm = TRUE)\n",
    "    }\n",
    "  }\n",
    "  return(df)\n",
    "}\n",
    "\n",
    "ballcomp <- stringr::str_split_fixed(rownames(allcomp), pattern = \"-\", n = 3) %>% as.data.frame\n",
    "rownames(ballcomp) <- rownames(allcomp)\n",
    "sallcomp <- smooth_zeros(allcomp)\n",
    "write.table(sallcomp, \"../04.matrices/comp/FNIH_heart_dhc_celltype_comp.impute.allbin.zerosmooth.txt\", \n",
    "            sep = \"\\t\", quote = F, row.names = T, col.names = T)"
   ]
  },
