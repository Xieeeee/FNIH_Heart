   "source": [
    "options(repr.plot.width = 4, repr.plot.height = 6)\n",
    "t1 <- log2(bk27ac[rownames(smat), colnames(smat)]+1) %>%\n",
    "pheatmap(scale = \"row\", cluster_cols = F, cluster_rows = F, show_rownames = F, angle_col = 45,\n",
    "         color = colorRampPalette(c(\"white\", \"#2EA7E0\"))(10))\n",
    "\n",
    "t1 <- log2(bk27me3[rownames(smat), colnames(smat)]+1) %>%\n",
    "pheatmap(scale = \"row\", cluster_cols = F, cluster_rows = F, show_rownames = F, angle_col = 45,\n",
    "         color = colorRampPalette(c(\"white\", \"#956134\"))(10))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "42ff4d13",
   "metadata": {},
   "source": [
    "## Select celltype-specific compartment to visualize"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 122,
   "id": "336863b2",
   "metadata": {},
   "outputs": [],
   "source": [
    "### use marker genes as reference\n",
    "### long gene only\n",
    "ggene <- read.table(\"/projects/ps-renlab2/y2xie/ps-renlab/y2xie/projects/genome_ref/Paired-Tag/hg38/hg38.gcode.10X.bed\")\n",
    "markers <- read.table(\"../../81.FNIH_DPT_IGM_240827/reference/LV_RV_LA_RA.multiome.mrg.filt.MTless.silQC.curated.RNA.marker.txt\", header = T)\n",
    "longgene <- ggene %>% filter(V3 - V2 >= 100000) %>% select(V6) %>% unlist %>% unique\n",
    "markers <- markers %>% filter(gene %in% longgene)\n",
    "\n",
    "qry_gene <- markers %>% filter(p_val_adj < 0.05) %>% \n",
    "filter(!grepl(\"^(AL|AC|LINC)\", gene)) %>% ### I want coding marker\n",
    "group_by(cluster) %>% \n",
    "slice_max(order_by = avg_log2FC, n = 50) %>%  \n",
    "ungroup() \n",
    "\n",
    "qry <- ggene %>% filter(V6 %in% unique(qry_gene$gene))\n",
    "qry.gr <- GRanges(qry[, 1], IRanges::IRanges(qry[, 2], qry[, 3]), gene = qry[,6])\n",
    "\n",
    "qry.bin <- qry.gr %>%\n",
    "as.data.frame %>%\n",
    "mutate(startb = floor(start / 100000), endb = ceiling(end / 100000)) %>%\n",
    "distinct\n",
    "\n",
    "### coarse into 100kb bin\n",
    "split_rows <- function(c, a, b, gene) {\n",
    "  if (b - a > 1) {\n",
    "    num_rows <- b - a\n",
    "    new_rows <- data.frame(seqnames = rep(c, times = num_rows), startb = a:(b-1), endb = (a+1):b, gene = rep(gene, times = num_rows))\n",
    "    return(new_rows)\n",
    "  } else {\n",
    "    return(data.frame(seqnames = c, startb = a, endb = b, gene = gene))\n",
    "  }\n",
    "}\n",
    "\n",
    "# Apply the function row-wise using dplyr\n",
    "result <- qry.bin %>%\n",
    "rowwise() %>%\n",
    "do(split_rows(.$seqnames, .$startb, .$endb, .$gene)) %>%\n",
    "ungroup()\n",
    "\n",
    "result <- result %>% \n",
    "distinct %>%\n",
    "mutate(start = 100000*startb, end = 100000*endb) %>%\n",
    "mutate(bin = paste0(seqnames, \"-\", as.integer(start)+1, \"-\", as.integer(end)))"
   ]
  },
