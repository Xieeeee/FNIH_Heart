   "source": [
    "options(repr.plot.width = 6, repr.plot.height = 5)\n",
    "t1 <- tmeta %>%\n",
    "ggplot(aes(x = predicted.score)) + \n",
    "geom_histogram(color = \"white\") + \n",
    "theme_Publication() # + scale_y_continuous(breaks = seq(0, 4000, 500))\n",
    "\n",
    "t1"
   ]
  },
