   "source": [
    "### read cooler dump results, raw\n",
    "contacts <- list()\n",
    "for (f in c(\"chr11:11840000-11850000\", \"chr11:11850000-11860000\")){\n",
    "    for (file in list.files(\"cooler_dump//NPPA_NPPB_raw/\", pattern = paste0(\".*\", f, \".*\"))){\n",
    "        fname <- paste0(stringr::str_split_fixed(file, pattern = \"_\", n = 4)[,1:3], collapse = \"_\")\n",
    "        cond <- paste0(stringr::str_split_fixed(file, pattern = \"_\", n = 4)[,2:3], collapse = \"_\")\n",
    "        contacts[[file]] <- read.table(paste0(\"cooler_dump//NPPA_NPPB_raw/\", file), sep = \"\\t\", header = T) %>%\n",
    "        mutate(donor = fname, cond = cond)\n",
    "    }\n",
    "}\n",
    "contacts <- do.call(rbind, contacts)\n",
    "t1 <- contacts %>% \n",
    "mutate(coord1 = paste0(chrom1, \":\", start1, \"-\", end1)) %>%\n",
    "mutate(coord2 = paste0(chrom2, \":\", start2, \"-\", end2)) %>%\n",
    "ggplot(aes(x = coord1, y = balanced, fill = cond)) +\n",
    "geom_boxplot(width = 0.5, color = \"black\", alpha = 0.8, coef = 2) + \n",
    "theme_Publication() + ylab(\"Balanced counts / Donor\") + \n",
    "scale_fill_manual(values = c('#B2DF8A', '#FF7F00'))\n",
    "\n",
    "t1\n",
    "ggsave(t1, filename = \"plot/FIG_vCM_Control_vs_HF_NPPA_NPPB_raw_balanced_counts.pdf\", dpi = 300, height = 6, width = 4)"
   ]
  }
 ],
