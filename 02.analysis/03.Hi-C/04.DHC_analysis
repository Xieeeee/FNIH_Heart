   "source": [
    "### decay: YOUNG forever\n",
    "dk <- read.csv(\"plot/FIG_all_celltype_condition_decay_young.csv\", row.names = 1)\n",
    "dk[,c(\"celltype\", \"condition\")] <- stringr::str_split_fixed(dk$celltype, pattern = \"_\", n = 2)\n",
    "\n",
    "options(repr.plot.width = 10, repr.plot.height = 5)\n",
    "dk %>% filter(dist >= 2, region1 == \"chr1_p\") %>% \n",
    "filter(celltype %in% c(\"aCM\", \"vCM\")) %>%\n",
    "ggplot(aes(x = 10000*dist, y = balanced.avg.smoothed.agg)) + \n",
    "geom_line(aes(color = condition)) +\n",
    "scale_y_log10() + scale_x_log10() +\n",
    "theme_Publication() + \n",
    "scale_color_manual(values = colsn) + \n",
    "facet_grid(. ~ celltype)"
   ]
  },
