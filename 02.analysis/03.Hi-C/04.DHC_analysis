   "source": [
    "### differential compartment is calculated using dchic as described in scHiCluster\n",
    "comp <- read.csv('../04.matrices/comp/impute/celltype/dchic/DifferentialResult/fdr_result/differential.intra_sample_combined.pcQnm.bedGraph', sep='\\t', header = T)\n",
    "binall <- comp[,c('chr', 'start', 'end', 'sample_maha', 'pval', 'padj')]\n",
    "binall$bin <- paste0(binall$chr, \"-\", (binall$start + 1), \"-\", binall$end)\n",
    "\n",
    "rownames(comp) <- binall$bin\n",
    "comp <- comp[, corder] ### this is already quantile normalized\n",
    "\n",
    "dim(comp)\n",
    "idx <- which(binall$padj < 0.01)\n",
    "length(idx)"
   ]
  },
