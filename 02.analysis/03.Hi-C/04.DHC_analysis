     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "abd <- c('Endothelial', 'Fibroblast', 'Myeloid', 'aCM', 'vCM')\n",
    "bbd <- c('Adipocyte', 'Endocardial', 'Neuronal', 'Epicardial') ### PER DONOR\n",
    "t1 <- merge(compfuse2, canno, by.x = \"donor\", by.y = 0) %>% \n",
    "mutate(B_int = BB/BA, A_int = AA/AB, cross_int = (BA+AB)/(BB+AA)) %>%\n",
    "filter(donor %in% ydonor, (celltype %in% abd)) %>% # , celltype %in% abd\n",
    "select(c(celltype, condition.x, B_int, A_int, cross_int)) %>%\n",
    "reshape2::melt(value.vars = c(\"B_int\", \"A_int\", \"cross_int\")) %>%\n",
    "mutate(celltype = factor(celltype, levels = corder)) %>%\n",
    "arrange(celltype) %>%\n",
    "filter(variable == \"A_int\", !(celltype %in% bbd)) %>%\n",
    "ggplot(aes(x = celltype, y = value)) +\n",
    "geom_boxplot(aes(fill = condition.x), width = 0.5, coef = 2, outlier.shape = NA, position = position_dodge(width = 0.7)) +\n",
    "theme_classic() + theme(axis.text.x = element_blank()) + \n",
    "xlab(\"\") + ylab(\"Intra A compartment\") + \n",
    "scale_fill_manual(values = c(\"CONTROL\" = '#B2DF8A',\"HF\" = '#CAB2D6'))\n",
    "\n",
    "t2 <- merge(compfuse2, canno, by.x = \"donor\", by.y = 0) %>% \n",
    "mutate(B_int = BB/BA, A_int = AA/AB, cross_int = (BA+AB)/(BB+AA)) %>%\n",
    "filter(donor %in% ydonor, (celltype %in% abd)) %>% # , celltype %in% abd\n",
    "select(c(celltype, condition.x, B_int, A_int, cross_int)) %>%\n",
    "reshape2::melt(value.vars = c(\"B_int\", \"A_int\", \"cross_int\")) %>%\n",
    "mutate(celltype = factor(celltype, levels = corder)) %>%\n",
    "arrange(celltype) %>%\n",
    "filter(variable == \"B_int\") %>%\n",
    "ggplot(aes(x = celltype, y = value)) +\n",
    "geom_boxplot(aes(fill = condition.x), width = 0.5, coef = 2, outlier.shape = NA, position = position_dodge(width = 0.7)) +\n",
    "theme_classic() + theme(axis.text.x = element_blank()) + \n",
    "xlab(\"\") + ylab(\"Intra B compartment\") + \n",
    "scale_fill_manual(values = c(\"CONTROL\" = '#B2DF8A',\"HF\" = '#CAB2D6'))\n",
    "\n",
    "t3 <- merge(compfuse2, canno, by.x = \"donor\", by.y = 0) %>% \n",
    "mutate(B_int = BB/BA, A_int = AA/AB, cross_int = (BA+AB)/(BB+AA)) %>%\n",
    "filter(donor %in% ydonor, (celltype %in% abd)) %>% # , celltype %in% abd\n",
    "select(c(celltype, condition.x, B_int, A_int, cross_int)) %>%\n",
    "reshape2::melt(value.vars = c(\"B_int\", \"A_int\", \"cross_int\")) %>%\n",
    "mutate(celltype = factor(celltype, levels = corder)) %>%\n",
    "arrange(celltype) %>%\n",
    "filter(variable == \"cross_int\") %>%\n",
    "ggplot(aes(x = celltype, y = value)) +\n",
    "geom_boxplot(aes(fill = condition.x), width = 0.5, coef = 2, outlier.shape = NA, position = position_dodge(width = 0.7)) +\n",
    "theme_classic() + theme(axis.text.x = element_text(angle = 45, hjust = 1)) + \n",
    "xlab(\"\") + ylab(\"Inter compartment\") + \n",
    "scale_fill_manual(values = c(\"CONTROL\" = '#B2DF8A',\"HF\" = '#CAB2D6'))\n",
    "\n",
    "options(repr.plot.width = 6, repr.plot.height = 6)\n",
    "fig1 <- cowplot::plot_grid(t1, t2, t3, nrow = 3, rel_heights = c(1, 1, 1.2), align = 'v')\n",
    "fig1"
   ]
  },
  {
