   "source": [
    "cdk <- read.csv(\"plot/FIG_all_celltype_decay.csv\", row.names = 1)\n",
    "\n",
    "options(repr.plot.width = 5, repr.plot.height = 5)\n",
    "cdk %>% filter(dist >= 2, region1 == \"chr1_p\") %>% \n",
    "mutate(celltype = factor(celltype, level = corder)) %>%\n",
    "ggplot(aes(x = 10000*dist, y = balanced.avg.smoothed.agg)) + \n",
    "geom_line(aes(color = celltype)) +\n",
    "scale_y_log10() + scale_x_log10() +\n",
    "theme_Publication() + \n",
    "scale_color_manual(values = celltype_colors)"
   ]
  },
