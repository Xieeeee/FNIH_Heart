   ],
   "source": [
    "compfuse2 <- read.csv(\"../../87.FNIH_DHC_IGM_240925/04.matrices/comp/FNIH_heart_dhc_donor_celltype_HF_compstr.impute.csv\", row.names = 1)\n",
    "compfuse2[,c(\"donor\", \"celltype\", \"condition\")] <- stringr::str_split_fixed(rownames(compfuse2), pattern = \"_\", n = 3)\n",
    "ttp <- compfuse2 %>% mutate(B_int = BB/BA, A_int = AA/AB, cross_int = (BA+AB)/(BB+AA)) %>%\n",
    "# filter(celltype %in% abd) %>%\n",
    "reshape2::dcast(donor ~ celltype, value.var = \"cross_int\") %>%\n",
    "tibble::column_to_rownames(\"donor\")\n",
    "ttp <- ttp[!is.na(rowSums(ttp)),]\n",
    "\n",
    "canno <- compfuse2 %>% filter(donor %in% rownames(ttp)) %>%\n",
    "select(c(donor, condition)) %>% distinct\n",
    "rownames(canno) <- canno$donor\n",
    "canno$donor <- NULL\n",
    "dage <- meta %>% filter(orig.ident != \"DHC\") %>% select(c(DONOR, HF, Age)) %>% distinct\n",
    "canno <- merge(canno, dage, by.x = 0, by.y = \"DONOR\") %>% tibble::column_to_rownames(\"Row.names\")\n",
    "ydonor <- canno %>% filter(Age < 60) %>% rownames\n",
    "\n",
    "annoc <- list(condition = c(\"CONTROL\" = '#B2DF8A',\"HF\" = '#6F4066'),\n",
    "             HF = c(\"CONTROL\" = '#B2DF8A',\"Ischemic\" = '#FF7F00', \"Non-ischemic\" = '#CAB2D6'))\n",
    "\n",
    "options(repr.plot.width = 9, repr.plot.height = 5)\n",
    "t(ttp) %>%\n",
    "pheatmap(cluster_cols = F, scale = \"row\", border_color = NA, angle_col = 45, \n",
    "         annotation_colors = annoc,\n",
    "         annotation_col = canno)"
   ]
  },
