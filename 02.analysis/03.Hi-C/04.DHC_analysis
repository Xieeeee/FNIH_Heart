   ],
   "source": [
    "### Only display selected celltypes \n",
    "korder <- c(\"Myeloid\", \"Endothelial\", \"Fibroblast\", \"aCM\", \"vCM\")\n",
    "t1 <- do.call(rbind, ab) %>% select(celltype) %>% table %>% as.data.frame %>% mutate(type = \"A2B\")\n",
    "t2 <- do.call(rbind, ba) %>% select(celltype) %>% table %>% as.data.frame %>% mutate(type = \"B2A\")\n",
    "fig1 <- rbind(t1, t2) %>%\n",
    "filter(celltype %in% korder) %>%\n",
    "mutate(celltype = factor(celltype, levels = korder)) %>%\n",
    "arrange(celltype) %>%\n",
    "ggplot(aes(x = celltype, y = Freq, fill = type)) + \n",
    "geom_col(position = \"dodge\", color = \"white\") + \n",
    "theme_Publication() +\n",
    "xlab(\"\") + ylab(\"Number\") + \n",
    "theme(axis.text.x = element_text(angle = 45, hjust = 1)) + \n",
    "scale_fill_manual(values = colorRampPalette((brewer.pal(n = 8, name = \"RdBu\")))(8)[c(7, 1)])\n",
    "\n",
    "t1 <- do.call(rbind, afb) %>% select(celltype) %>% table %>% as.data.frame %>% mutate(type = \"A2B\")\n",
    "t2 <- do.call(rbind, bfa) %>% select(celltype) %>% table %>% as.data.frame %>% mutate(type = \"B2A\")\n",
    "fig2 <- rbind(t1, t2) %>%\n",
    "filter(celltype %in% korder) %>%\n",
    "mutate(celltype = factor(celltype, levels = korder)) %>%\n",
    "arrange(celltype) %>%\n",
    "ggplot(aes(x = celltype, y = Freq, fill = type)) + \n",
    "geom_col(position = \"dodge\", color = \"white\") + \n",
    "theme_Publication() +\n",
    "xlab(\"\") + ylab(\"Number\") + \n",
    "theme(axis.text.x = element_text(angle = 45, hjust = 1)) + \n",
    "scale_fill_manual(values = colorRampPalette((brewer.pal(n = 8, name = \"RdBu\")))(8)[c(7, 1)])\n",
    "\n",
    "\n",
    "options(repr.plot.width = 6, repr.plot.height = 4)\n",
    "fig1\n",
    "fig2"
   ]
  },
