   "source": [
    "### Find examples for cell type specific boundary?\n",
    "qmtx <- apply(smat, MARGIN = 1, function(x) (x - mean(x))/sd(x)) %>% t %>% as.data.frame\n",
    "qbin <- qmtx %>% tibble::rownames_to_column(\"bin\") %>% \n",
    "reshape2::melt() %>%\n",
    "group_by(variable) %>%\n",
    "slice_max(order_by = value, n = 3)\n",
    "              \n",
    "qbin$bin %>% length\n",
    "qbin$bin %>% unique %>% length"
   ]
  },
