   ],
   "source": [
    "dk <- read.csv(\"plot/FIG_all_celltype_condition_decay.csv\", row.names = 1)\n",
    "dk[,c(\"celltype\", \"condition\")] <- stringr::str_split_fixed(dk$celltype, pattern = \"_\", n = 2)\n",
    "\n",
    "dk %>% filter(dist >= 2, region1 == \"chr1_p\") %>%\n",
    "dplyr::select(dist, celltype, condition, balanced.avg.smoothed.agg) %>%\n",
    "dplyr::group_by(dist, celltype) %>%\n",
    "tidyr::pivot_wider(names_from = condition, values_from = balanced.avg.smoothed.agg) %>%\n",
    "ungroup %>%\n",
    "mutate(log2_ratio = log2(HF / CONTROL)) %>%\n",
    "filter(celltype %in% korder) %>%\n",
    "ggplot(aes(x = 10000*dist, y = log2_ratio, color = celltype)) + \n",
    "geom_line() +\n",
    "scale_x_log10() +\n",
    "theme_Publication() + \n",
    "scale_color_manual(values = celltype_colors)"
   ]
  },
