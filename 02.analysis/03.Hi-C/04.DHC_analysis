   ],
   "source": [
    "t1 <- meta[meta$orig.ident == \"DHC\", c(\"DONOR\", \"Age\", \"condition\")] %>% \n",
    "distinct %>%\n",
    "filter(Age <= 60) %>%\n",
    "ggplot(aes(x = condition, y = Age)) + \n",
    "geom_boxplot() + \n",
    "geom_jitter(aes(color = condition)) + \n",
    "theme_classic()\n",
    "\n",
    "t1\n",
    "\n",
    "wilcox.test(t1$data[t1$data$condition == \"HF\",]$Age,\n",
    "            t1$data[t1$data$condition == \"CONTROL\",]$Age, exact = FALSE)\n",
    "\n",
    "### retain young donors for comparsions only (Ages <= 60)"
   ]
  },
