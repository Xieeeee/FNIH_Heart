  {
   "cell_type": "markdown",
   "id": "f792c1f6-1257-49c2-be41-d5590392fc4c",
   "metadata": {},
   "source": [
    "## Domain analysis by cell types"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 620,
   "id": "160c23e3",
   "metadata": {},
   "outputs": [],
   "source": [
    "library(anndata)\n",
    "bound_prob = read.csv(\"../impute/25K/cool/DONOR/FNIH_Heart_DHC_Donor_celltype_boundprob.csv\", row.names = 1)\n",
    "diffbound = read.csv(\"../impute/25K/cool/DONOR/FNIH_Heart_DHC_DONOR_celltype_disease_diffbound.csv\", row.names = 1)\n",
    "bklfilter <- diffbound[diffbound$bklfilter == 'True',]$bin\n",
    "\n",
    "bound <- read_h5ad(\"../impute/25K/domain/pseudobulk/FNIH_Heart_pseudobulk.boundary.h5ad\")\n",
    "ins <- read.csv(\"../impute/25K/domain/pseudobulk/FNIH_Heart_pseudobulk.insulation.csv\", row.names = 1)\n",
    "\n",
    "bbin <- bound$var %>% mutate(range = paste0(chrom, \"-\", start, \"-\", end))\n",
    "bound <- as.data.frame(t(bound$X))\n",
    "rownames(bound) <- bbin$range "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 533,
   "id": "79388539",
   "metadata": {},
   "outputs": [],
   "source": [
    "### bulk boundary plot\n",
    "idxl <- bound %>% apply(MARGIN = 2, function(x) which(x > 0))\n",
    "boundl <- lapply(idxl, function(x) rownames(bound)[x])"
   ]
  },
