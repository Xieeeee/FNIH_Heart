   "source": [
    "options(repr.plot.width = 4, repr.plot.height = 6)\n",
    "\n",
    "rmat <- comp[idx, corder]\n",
    "max_indices <- max.col(rmat)\n",
    "permutation_vector <- order(max_indices)\n",
    "smat <- rmat[permutation_vector, ]\n",
    "t1 <- smat %>% ### this is not raw compartment score: after dchic normalization!\n",
    "pheatmap(scale = \"row\", cluster_rows = F, cluster_cols = F, show_rownames = F, angle_col = 45,\n",
    "         color = colorRampPalette(rev(brewer.pal(n = 8, name = \"RdBu\")))(20))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 99,
   "id": "b76bdd6c",
   "metadata": {},
   "outputs": [],
   "source": [
    "### compare with histone modification\n",
    "bk27ac <- read.csv(\"../../81.FNIH_DPT_IGM_240827/05.R/FNIH_Heart_signal/FNIH_Heart_pool.H3K27ac.100kb.cpm.csv\", row.names = 1)\n",
    "bk27me3 <- read.csv(\"../../81.FNIH_DPT_IGM_240827/05.R/FNIH_Heart_signal/FNIH_Heart_pool.H3K27me3.100kb.cpm.csv\", row.names = 1)\n",
    "b100k <- stringr::str_split_fixed(rownames(bk27ac), pattern = \"[-:]\", n = 3) %>% as.data.frame\n",
    "rownames(bk27ac) <- rownames(bk27me3) <- paste0(b100k$V1, \"-\", (as.integer(b100k$V2)+1), \"-\", b100k$V3)"
   ]
  },
