   ],
   "source": [
    "plist <- list()\n",
    "for (i in 1:nrow(qtp)){\n",
    "    chrom <- qtp$V1[i]\n",
    "    start <- as.integer(qtp$V2[i]) - 2000000\n",
    "    end <- as.integer(qtp$V3[i]) + 2000000\n",
    "    vbin <- ballcomp %>% filter(V1 == chrom & as.integer(V2) >= start & as.integer(V3) <= end) %>% rownames %>% \n",
    "    as.data.frame %>% setNames(\"bin\") %>% mutate(rank = seq_along(bin))\n",
    "    tmp <- sallcomp %>% tibble::rownames_to_column(\"bin\") %>%\n",
    "    filter(bin %in% vbin$bin) \n",
    "    tmp$rank <- vbin[match(tmp$bin, vbin$bin),]$rank\n",
    "    \n",
    "    plist[[i]] <- tmp %>%\n",
    "    reshape2::melt(id.vars = c(\"bin\", \"rank\")) %>%\n",
    "    mutate(variable = factor(variable, levels = corder)) %>% arrange(variable) %>%\n",
    "    ggplot(aes(x = rank, y = value, fill = ifelse(value > 0, \"red\", \"blue\"))) + \n",
    "    geom_col(width = 1) + xlab(paste0(chrom, \":\", start, \"-\", end)) + ylab(\"\") + \n",
    "    annotate(\"rect\", xmin=19, xmax=21, ymin=-Inf, ymax=Inf, alpha=0.5, fill=\"grey\") + \n",
    "    theme_classic() + \n",
    "    theme(axis.line.x = element_blank(), axis.text.x = element_blank()) + \n",
    "    scale_fill_manual(values = c(\"blue\", \"red\")) + NoLegend() + \n",
    "    facet_grid(variable ~ .)\n",
    "}\n",
    "\n",
    "fig1 <- cowplot::plot_grid(plotlist = plist, ncol = nrow(qtp))\n",
    "\n",
    "options(repr.plot.width = 15, repr.plot.height = 10)\n",
    "fig1"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a888f465",
   "metadata": {},
   "source": [
    "## Compartment shifts in disease"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 557,
   "id": "c40b322a",
   "metadata": {},
   "outputs": [],
   "source": [
    "comp <- read.csv(\"../04.matrices/comp/FNIH_heart_dhc_celltype_HF_comp.impute.csv\", header = T, row.names = 1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "9b2ddc0a",
   "metadata": {},
   "outputs": [],
   "source": [
    "dcomp <- idxl <- idyl <- list()\n",
    "for (f in corder){\n",
    "    dcomp[[f]] <- read.csv(paste0('../04.matrices/comp/impute/disease/pairwise_disease/', f, '/DifferentialResult/fdr_result/differential.intra_sample_combined.pcQnm.bedGraph'), sep='\\t', header = T)\n",
    "    binall <- dcomp[[f]][,c('chr', 'start', 'end', 'sample_maha', 'pval', 'padj')]\n",
    "    binall$bin <- paste0(binall$chr, \"-\", binall$start, \"-\", binall$end)\n",
    "    idy <- binall[which(scale(binall[,'sample_maha']) > abs(stats::qnorm(0.025)) & binall$padj < 0.05),]\n",
    "    idx <- binall[which(binall$padj < 0.05),]\n",
    "    idxl[[f]] <- idx\n",
    "    idyl[[f]] <- idy\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 122,
   "id": "0ba8b552",
   "metadata": {},
   "outputs": [],
   "source": [
    "## Plot compartment shift flow chart\n",
    "suppressPackageStartupMessages(library(ggalluvial))\n",
    "path1 <- \"/projects/ps-renlab2/y2xie/projects/77.LC/87.FNIH_DHC_IGM_240925/04.matrices/comp/impute/disease/\"\n",
    "\n",
    "chic <- phic <- list()\n",
    "for (f in list.files(path1, pattern = \".bedGraph$\")){\n",
    "    fname = gsub(\"_impute_comp.bedGraph\", \"\", f)\n",
    "    tmp <- read.table(paste0(path1, f), skip = 1) %>% \n",
    "    mutate(type = ifelse(V4 > 0, \"A\", \"B\")) %>%\n",
    "    setNames(c(\"chrom\", \"start\", \"end\", \"score\", \"type\")) %>%\n",
    "    mutate(bin = paste0(chrom, \"_\", start, \"_\", end)) %>% \n",
    "    tibble::column_to_rownames(\"bin\") \n",
    "    \n",
    "    tmp1 <- tmp %>% select(type)\n",
    "    colnames(tmp1) <- fname\n",
    "    phic[[fname]] <- tmp1\n",
    "    \n",
    "    tmp2 <- tmp %>% select(score)\n",
    "    colnames(tmp2) <- fname\n",
    "    chic[[fname]] <- tmp2\n",
    "}\n",
    "commonf <- Reduce(intersect, lapply(phic, rownames))\n",
    "for (f in names(phic)){\n",
    "    phic[[f]] <- phic[[f]][commonf, , drop = F]\n",
    "}\n",
    "phic <- Reduce(cbind, phic[-1], phic[[1]]) ### dont use do.call for cbind\n",
    "\n",
    "for (f in names(chic)){\n",
    "    chic[[f]] <- chic[[f]][commonf, , drop = F]\n",
    "}\n",
    "chic <- Reduce(cbind, chic[-1], chic[[1]])\n",
    "\n",
    "write.table(phic, \n",
    "            \"/projects/ps-renlab2/y2xie/projects/77.LC/87.FNIH_DHC_IGM_240925/04.matrices/comp/impute/disease/imputed_comp_AB.tsv\",\n",
    "           sep = \"\\t\", quote = F, row.names = T, col.names = T)"
   ]
  },
