   "source": [
    "### How much switching agrees with diff results?\n",
    "f1 <- do.call(rbind, ab) %>% dplyr::select(bin) %>% unlist %>% unique\n",
    "f2 <- do.call(rbind, ba) %>% dplyr::select(bin) %>% unlist %>% unique\n",
    "\n",
    "f3 <- gsub(\"-\", \"_\", ctdiff)\n",
    "\n",
    "length(f1)\n",
    "length(f2)\n",
    "length(f3)\n",
    "intersect(f1, f3) %>% length\n",
    "intersect(f2, f3) %>% length\n",
    "### most (79.7% a2b, 77.1% b2a) switched are within diff comp"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 244,
   "id": "8f5774c9",
   "metadata": {},
   "outputs": [],
   "source": [
    "ggene <- read.table(\"/projects/ps-renlab2/y2xie/ps-renlab/y2xie/projects/genome_ref/Paired-Tag/hg38/hg38.gcode.10X.bed\")\n",
    "geneder <- read.table(\"../../81.FNIH_DPT_IGM_240827/reference/Multiome_Downstream/CHAMBER/4chambers_DESEQ2_RNA.dds.res\", header = T) %>%\n",
    "setNames(c(\"celltype\", \"contrast\", \"gene\", \"log2FoldChange\", \"stat\", \"pvalue\", \"padj\"))\n",
    "genede <- geneder %>% filter(padj < 0.05)\n",
    "\n",
    "atacder <- read.table(\"../../81.FNIH_DPT_IGM_240827/reference/Multiome_Downstream/CHAMBER/4chambers_DESEQ2_ATAC.dds.res\", header = T) %>%\n",
    "setNames(c(\"celltype\", \"contrast\", \"range\", \"log2FoldChange\", \"stat\", \"pvalue\", \"padj\"))\n",
    "atacde <- atacder %>% filter(padj < 0.05)\n",
    "\n",
    "qry_gene <- genede %>% filter(!grepl(\"^(AL|AC|LINC)\", gene)) \n",
    "\n",
    "qry <- ggene %>% filter(V6 %in% unique(qry_gene$gene))\n",
    "qry.gr <- GRanges(qry[, 1], IRanges::IRanges(qry[, 2], qry[, 3]), gene = qry[,6])\n",
    "\n",
    "qry.bin <- qry.gr %>%\n",
    "as.data.frame %>%\n",
    "mutate(startb = floor(start / 100000), endb = ceiling(end / 100000)) %>%\n",
    "distinct\n",
    "\n",
    "### coarse into 100kb bin\n",
    "split_rows <- function(c, a, b, gene) {\n",
    "  if (b - a > 1) {\n",
    "    num_rows <- b - a\n",
    "    new_rows <- data.frame(seqnames = rep(c, times = num_rows), \n",
    "                           startb = a:(b-1), \n",
    "                           endb = (a+1):b, \n",
    "                           gene = rep(gene, times = num_rows))\n",
    "    return(new_rows)\n",
    "  } else {\n",
    "    return(data.frame(seqnames = c, startb = a, endb = b, gene = gene))\n",
    "  }\n",
    "}\n",
    "\n",
    "# Apply the function row-wise using dplyr\n",
    "result <- qry.bin %>%\n",
    "rowwise() %>%\n",
    "do(split_rows(.$seqnames, .$startb, .$endb, .$gene)) %>%\n",
    "ungroup()\n",
    "\n",
    "result <- result %>% \n",
    "distinct %>%\n",
    "mutate(start = 100000*startb, end = 100000*endb) %>%\n",
    "mutate(bin = paste0(seqnames, \"-\", as.integer(start), \"-\", as.integer(end)))"
   ]
  },
