   ],
   "source": [
    "options(repr.plot.width = 5, repr.plot.height = 5)\n",
    "t1 <- dk %>% filter(dist >= 2, region1 == \"chr1_p\") %>%\n",
    "dplyr::select(dist, celltype, condition, balanced.avg.smoothed.agg) %>%\n",
    "dplyr::group_by(dist, celltype) %>%\n",
    "tidyr::pivot_wider(names_from = condition, values_from = balanced.avg.smoothed.agg) %>%\n",
    "ungroup %>%\n",
    "mutate(log2_ratio = log2(HF / CONTROL)) %>%\n",
    "filter(celltype %in% korder) %>%\n",
    "ggplot(aes(x = 10000*dist, y = log2_ratio, color = celltype)) + \n",
    "geom_line() +\n",
    "scale_x_log10() +\n",
    "theme_Publication() + \n",
    "scale_color_manual(values = celltype_colors)\n",
    "\n",
    "t1\n",
    "ggsave(t1, filename = \"plot/FIG_CONTROL_vs_HF_decay_log2_ratio_young.pdf\", dpi = 300, height = 6.5, width = 6)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 927,
   "id": "30a78c4a",
   "metadata": {},
   "outputs": [],
   "source": [
    "### decay by compartment\n",
    "adk <- read.csv(\"plot/FIG_all_celltype_condition_decay_in_Acomp.young.csv\", row.names = 1)\n",
    "bdk <- read.csv(\"plot/FIG_all_celltype_condition_decay_in_Bcomp.young.csv\", row.names = 1)\n",
    "\n",
    "adk[,c(\"celltype\", \"condition\")] <- stringr::str_split_fixed(adk$celltype, pattern = \"_\", n = 2)\n",
    "bdk[,c(\"celltype\", \"condition\")] <- stringr::str_split_fixed(bdk$celltype, pattern = \"_\", n = 2)"
   ]
  },
