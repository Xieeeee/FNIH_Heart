     "metadata": {
      "image/png": {
       "height": 720,
       "width": 240
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "options(repr.plot.width = 4, repr.plot.height = 12)\n",
    "fig1 <- do.call(rbind, benrich) %>% group_by(variable, bound) %>%\n",
    "mutate(ratio = value/mean(value)) %>%\n",
    "ungroup() %>% \n",
    "mutate(condition = stringr::str_split_fixed(variable, pattern = \"_\", n = 2)[,2]) %>%\n",
    "filter(condition != \"\") %>%\n",
    "filter(bound %in% c(\"vCM\", \"aCM\", \"Fibroblast\", \"Endothelial\", \"Myeloid\")) %>%\n",
    "mutate(bound = factor(bound, levels = c(\"vCM\", \"aCM\", \"Fibroblast\", \"Endothelial\", \"Myeloid\"))) %>%\n",
    "filter(id >= 6 & id <= 16) %>%\n",
    "ggplot(aes(x = id, y = ratio, color = condition)) + \n",
    "geom_line() + \n",
    "theme_classic() + scale_color_manual(values = colsn) + \n",
    "facet_grid(bound ~ .)\n",
    "\n",
    "fig1\n",
    "\n",
    "ggsave(fig1, filename = \"plot/FNIH_Heart_DHC_ins_by_celltype_condition_young.pdf\", dpi = 300, height = 12, width = 4)"
   ]
  },
