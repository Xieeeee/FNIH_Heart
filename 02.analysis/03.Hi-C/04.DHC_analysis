   ],
   "source": [
    "t1 <- adk %>% filter(dist >= 2) %>%\n",
    "filter(celltype %in% korder) %>%\n",
    "group_by(dist, celltype, condition) %>%\n",
    "summarise(mean_score = mean(balanced.avg.smoothed.agg)) %>%\n",
    "ungroup %>%\n",
    "dplyr::group_by(dist, celltype) %>%\n",
    "tidyr::pivot_wider(names_from = condition, values_from = mean_score) %>%\n",
    "ungroup %>%\n",
    "mutate(log2_ratio = log2(HF / CONTROL)) %>%\n",
    "ggplot(aes(x = 10000*dist, y = log2_ratio, color = celltype)) + \n",
    "geom_line() +\n",
    "scale_x_log10() +\n",
    "theme_Publication() + ggtitle(\"Decay in A\") %>%\n",
    "scale_color_manual(values = celltype_colors) \n",
    "\n",
    "t2 <- bdk %>% filter(dist >= 2) %>%\n",
    "filter(celltype %in% korder) %>%\n",
    "group_by(dist, celltype, condition) %>%\n",
    "summarise(mean_score = mean(balanced.avg.smoothed.agg)) %>%\n",
    "ungroup %>%\n",
    "dplyr::group_by(dist, celltype) %>%\n",
    "tidyr::pivot_wider(names_from = condition, values_from = mean_score) %>%\n",
    "ungroup %>%\n",
    "mutate(log2_ratio = log2(HF / CONTROL)) %>%\n",
    "ggplot(aes(x = 10000*dist, y = log2_ratio, color = celltype)) + \n",
    "geom_line() +\n",
    "scale_x_log10() +\n",
    "theme_Publication() + ggtitle(\"Decay in B\") %>%\n",
    "scale_color_manual(values = celltype_colors) \n",
    "\n",
    "fig1 <- cowplot::plot_grid(t1, t2, ncol = 2)\n",
    "\n",
    "options(repr.plot.width = 10, repr.plot.height = 5)\n",
    "fig1\n",
    "\n",
    "ggsave(fig1, filename = \"plot/FIG_CONTROL_vs_HF_decay_log2_ratio_young_AB.pdf\", dpi = 300, height = 5, width = 10)"
   ]
  },
